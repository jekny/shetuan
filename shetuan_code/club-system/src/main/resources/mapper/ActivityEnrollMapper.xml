<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shetuan.mapper.ActivityEnrollMapper">
    <select id="selectByActUser" resultType="ActivityEnroll">
        select * from activity_enroll where activity_id=#{activityId} and user_id=#{userId}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into activity_enroll(activity_id,user_id) values(#{activityId},#{userId})
    </insert>
    <delete id="deleteByActUser">
        delete from activity_enroll where activity_id=#{activityId} and user_id=#{userId}
    </delete>
    <select id="selectByUserId" resultType="ActivityEnroll">
        select * from activity_enroll where user_id=#{userId}
    </select>
    <select id="selectByActivityId" resultType="ActivityEnroll">
        select * from activity_enroll where activity_id=#{activityId}
    </select>
    <select id="countByActivity" resultType="Integer">
        select count(1) from activity_enroll where activity_id=#{activityId}
    </select>
</mapper>