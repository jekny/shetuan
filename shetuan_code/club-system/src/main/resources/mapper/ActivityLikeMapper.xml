<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shetuan.mapper.ActivityLikeMapper">
    <select id="selectByActUser" resultType="ActivityLike">
        select * from activity_like where activity_id=#{activityId} and user_id=#{userId}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into activity_like(activity_id,user_id) values(#{activityId},#{userId})
    </insert>
    <delete id="deleteByActUser">
        delete from activity_like where activity_id=#{activityId} and user_id=#{userId}
    </delete>
</mapper>